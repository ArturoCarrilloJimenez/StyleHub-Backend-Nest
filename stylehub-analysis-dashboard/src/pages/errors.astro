---
import Layout from '../components/Layout.astro';
import Card from '../components/Card.astro';
import '../styles/global.css';

const handleExceptionsCode = `export const handleExceptions = (error: any, logger: Logger) => {
  if (error.code === '23505') {
    throw new BadRequestException(error.detail);
  }
  
  logger.error(error);
  throw new InternalServerErrorException(
    'Unexpected error, check server logs',
  );
};`;

const usageExample = `async create(createProductDto: CreateProductDto, user: UserEntity) {
  const { type, ...productDetail } = createProductDto;
  const findType = await this.productTypeService.findOne(type);
  
  try {
    const product = this.productRepository.create({
      ...productDetail,
      user,
      type: findType,
    });
    await this.productRepository.save(product);
    return product;
  } catch (error) {
    handleExceptions(error, this.logger);
  }
}`;
---

<Layout title="Error Handling" currentPage="/errors">
  <div class="space-y-6">
    <Card title="Centralized Error Handling">
      <p class="text-gray-700 mb-4">
        El sistema implementa un manejador centralizado de excepciones ubicado en 
        <code class="bg-gray-100 px-2 py-1 rounded">src/commons/utils/handleExceptions.utils.ts</code>
      </p>
      <pre class="code-block"><code>{handleExceptionsCode}</code></pre>
    </Card>

    <Card title="Exception Types">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="border border-red-200 rounded-lg p-4 bg-red-50">
          <h4 class="font-semibold text-red-900 mb-2">BadRequestException</h4>
          <p class="text-sm text-red-700 mb-2">HTTP 400 - Solicitud inválida</p>
          <p class="text-xs text-red-600">Usado para: Validaciones de negocio, datos duplicados, carrito vacío</p>
        </div>
        <div class="border border-orange-200 rounded-lg p-4 bg-orange-50">
          <h4 class="font-semibold text-orange-900 mb-2">UnauthorizedException</h4>
          <p class="text-sm text-orange-700 mb-2">HTTP 401 - No autorizado</p>
          <p class="text-xs text-orange-600">Usado para: Credenciales inválidas, token expirado, usuario inactivo</p>
        </div>
        <div class="border border-yellow-200 rounded-lg p-4 bg-yellow-50">
          <h4 class="font-semibold text-yellow-900 mb-2">NotFoundException</h4>
          <p class="text-sm text-yellow-700 mb-2">HTTP 404 - No encontrado</p>
          <p class="text-xs text-yellow-600">Usado para: Producto no existe, orden no encontrada, usuario no existe</p>
        </div>
        <div class="border border-purple-200 rounded-lg p-4 bg-purple-50">
          <h4 class="font-semibold text-purple-900 mb-2">InternalServerErrorException</h4>
          <p class="text-sm text-purple-700 mb-2">HTTP 500 - Error del servidor</p>
          <p class="text-xs text-purple-600">Usado para: Errores inesperados, fallos de base de datos</p>
        </div>
      </div>
    </Card>

    <Card title="Database Error Handling">
      <p class="text-gray-700 mb-4">
        El sistema maneja específicamente errores de PostgreSQL:
      </p>
      <div class="space-y-3">
        <div class="bg-gray-50 p-4 rounded-lg">
          <h4 class="font-semibold text-gray-800 mb-2">Error Code 23505 - Unique Violation</h4>
          <p class="text-sm text-gray-700">
            Cuando se intenta insertar un valor duplicado en un campo con constraint UNIQUE 
            (email, fullName, slug, etc.), se captura y se lanza un BadRequestException con el detalle del error.
          </p>
        </div>
        <div class="bg-gray-50 p-4 rounded-lg">
          <h4 class="font-semibold text-gray-800 mb-2">Other Database Errors</h4>
          <p class="text-sm text-gray-700">
            Cualquier otro error de base de datos se registra en los logs y se devuelve un 
            InternalServerErrorException genérico para no exponer detalles internos.
          </p>
        </div>
      </div>
    </Card>

    <Card title="Usage Example">
      <p class="text-gray-700 mb-4">
        Ejemplo de uso en ProductsService:
      </p>
      <pre class="code-block"><code>{usageExample}</code></pre>
    </Card>

    <Card title="Logging Strategy">
      <p class="text-gray-700 mb-4">
        Cada servicio tiene su propio logger de NestJS:
      </p>
      <div class="space-y-3">
        <div class="bg-blue-50 p-4 rounded-lg">
          <h4 class="font-semibold text-blue-900 mb-2">Logger Initialization</h4>
          <code class="text-sm">private readonly logger = new Logger('ServiceName');</code>
        </div>
        <div class="bg-green-50 p-4 rounded-lg">
          <h4 class="font-semibold text-green-900 mb-2">Error Logging</h4>
          <p class="text-sm text-green-700">
            Todos los errores se registran con <code>logger.error(error)</code> antes de lanzar la excepción
          </p>
        </div>
        <div class="bg-purple-50 p-4 rounded-lg">
          <h4 class="font-semibold text-purple-900 mb-2">Context Information</h4>
          <p class="text-sm text-purple-700">
            El nombre del servicio en el logger ayuda a identificar rápidamente el origen del error
          </p>
        </div>
      </div>
    </Card>

    <Card title="Validation Errors">
      <p class="text-gray-700 mb-4">
        Las validaciones de DTOs se manejan automáticamente por ValidationPipe:
      </p>
      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th>Decorator</th>
              <th>Validation</th>
              <th>Error Message</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code class="text-xs">@IsEmail()</code></td>
              <td>Email válido</td>
              <td class="text-sm text-gray-600">email must be an email</td>
            </tr>
            <tr>
              <td><code class="text-xs">@IsString()</code></td>
              <td>Tipo string</td>
              <td class="text-sm text-gray-600">field must be a string</td>
            </tr>
            <tr>
              <td><code class="text-xs">@MinLength(6)</code></td>
              <td>Longitud mínima</td>
              <td class="text-sm text-gray-600">field must be longer than 6 characters</td>
            </tr>
            <tr>
              <td><code class="text-xs">@IsPositive()</code></td>
              <td>Número positivo</td>
              <td class="text-sm text-gray-600">field must be a positive number</td>
            </tr>
            <tr>
              <td><code class="text-xs">@IsArray()</code></td>
              <td>Tipo array</td>
              <td class="text-sm text-gray-600">field must be an array</td>
            </tr>
          </tbody>
        </table>
      </div>
    </Card>

    <Card title="Error Response Format">
      <p class="text-gray-700 mb-4">
        NestJS devuelve errores en formato JSON estándar:
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <h4 class="font-semibold text-gray-800 mb-2">BadRequestException</h4>
          <pre class="code-block text-xs"><code>{`{
  "statusCode": 400,
  "message": "Email already exists",
  "error": "Bad Request"
}`}</code></pre>
        </div>
        <div>
          <h4 class="font-semibold text-gray-800 mb-2">NotFoundException</h4>
          <pre class="code-block text-xs"><code>{`{
  "statusCode": 404,
  "message": "Product not found",
  "error": "Not Found"
}`}</code></pre>
        </div>
        <div>
          <h4 class="font-semibold text-gray-800 mb-2">UnauthorizedException</h4>
          <pre class="code-block text-xs"><code>{`{
  "statusCode": 401,
  "message": "Invalid credentials",
  "error": "Unauthorized"
}`}</code></pre>
        </div>
        <div>
          <h4 class="font-semibold text-gray-800 mb-2">Validation Error</h4>
          <pre class="code-block text-xs"><code>{`{
  "statusCode": 400,
  "message": [
    "email must be an email",
    "password must be longer than 6"
  ],
  "error": "Bad Request"
}`}</code></pre>
        </div>
      </div>
    </Card>

    <Card title="Best Practices">
      <ul class="space-y-2 text-gray-700">
        <li class="flex items-start">
          <span class="text-green-500 mr-2">✓</span>
          <span>Manejo centralizado de excepciones para consistencia</span>
        </li>
        <li class="flex items-start">
          <span class="text-green-500 mr-2">✓</span>
          <span>Logging de todos los errores para debugging</span>
        </li>
        <li class="flex items-start">
          <span class="text-green-500 mr-2">✓</span>
          <span>Mensajes de error descriptivos para el cliente</span>
        </li>
        <li class="flex items-start">
          <span class="text-green-500 mr-2">✓</span>
          <span>No exponer detalles internos en errores 500</span>
        </li>
        <li class="flex items-start">
          <span class="text-green-500 mr-2">✓</span>
          <span>Validación automática de DTOs con class-validator</span>
        </li>
        <li class="flex items-start">
          <span class="text-green-500 mr-2">✓</span>
          <span>Try-catch en operaciones de base de datos</span>
        </li>
      </ul>
    </Card>
  </div>
</Layout>
