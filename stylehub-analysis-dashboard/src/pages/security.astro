---
import Layout from '../components/Layout.astro';
import Card from '../components/Card.astro';
import { securityFeatures, guards, codeExamples } from '../data/securityData';
import '../styles/global.css';
---

<Layout title="Security Analysis" currentPage="/security">
  <div class="space-y-6">
    {securityFeatures.map(category => (
      <Card title={category.category}>
        <div class="space-y-4">
          {category.features.map(feature => (
            <div class="border-l-4 border-primary-500 pl-4 py-2">
              <h4 class="font-semibold text-gray-800 mb-1">{feature.name}</h4>
              <p class="text-sm text-gray-600 mb-2">{feature.description}</p>
              <div class="flex flex-wrap gap-2 text-xs">
                {feature.implementation && (
                  <span class="badge badge-info">{feature.implementation}</span>
                )}
                {feature.config && (
                  <span class="badge badge-warning">{feature.config}</span>
                )}
                {feature.guards && feature.guards.map(guard => (
                  <span class="badge badge-success">{guard}</span>
                ))}
                {feature.decorators && feature.decorators.map(dec => (
                  <span class="badge badge-info">{dec}</span>
                ))}
                {feature.examples && feature.examples.map(ex => (
                  <span class="badge">{ex}</span>
                ))}
                {feature.pipes && feature.pipes.map(pipe => (
                  <span class="badge badge-warning">{pipe}</span>
                ))}
                {feature.hooks && feature.hooks.map(hook => (
                  <span class="badge">{hook}</span>
                ))}
                {feature.entities && feature.entities.map(entity => (
                  <span class="badge badge-info">{entity}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </Card>
    ))}

    <Card title="Guards Implementation">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {guards.map(guard => (
          <div class="border border-gray-200 rounded-lg p-4">
            <h4 class="font-semibold text-gray-800 mb-2">{guard.name}</h4>
            <div class="space-y-2 text-sm">
              <div>
                <span class="text-gray-600">Type:</span>
                <span class="badge badge-info ml-2">{guard.type}</span>
              </div>
              <div>
                <span class="text-gray-600">Purpose:</span>
                <span class="text-gray-700 ml-2">{guard.purpose}</span>
              </div>
              <div>
                <span class="text-gray-600">Usage:</span>
                <code class="bg-gray-100 px-2 py-1 rounded text-xs ml-2">{guard.usage}</code>
              </div>
              <div>
                <span class="text-gray-600">Validates:</span>
                <ul class="list-disc list-inside ml-2 mt-1">
                  {guard.validates.map(item => (
                    <li class="text-gray-700">{item}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </Card>

    <Card title="JWT Strategy Implementation">
      <pre class="code-block"><code>{codeExamples.jwtStrategy}</code></pre>
    </Card>

    <Card title="Auth Decorator">
      <pre class="code-block"><code>{codeExamples.authDecorator}</code></pre>
    </Card>

    <Card title="Password Encryption">
      <pre class="code-block"><code>{codeExamples.passwordEncryption}</code></pre>
    </Card>

    <Card title="Security Best Practices">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-4 bg-green-50 rounded-lg">
          <h4 class="font-semibold text-green-900 mb-2">✅ Implemented</h4>
          <ul class="text-sm text-green-700 space-y-1 list-disc list-inside">
            <li>JWT token-based authentication</li>
            <li>Password hashing with bcrypt</li>
            <li>Role-based access control (RBAC)</li>
            <li>Input validation with class-validator</li>
            <li>Soft delete for user data</li>
            <li>Password field exclusion from responses</li>
            <li>Email sanitization (lowercase, trim)</li>
            <li>Unique constraints on critical fields</li>
          </ul>
        </div>
        <div class="p-4 bg-blue-50 rounded-lg">
          <h4 class="font-semibold text-blue-900 mb-2">🔐 Security Layers</h4>
          <ul class="text-sm text-blue-700 space-y-1 list-disc list-inside">
            <li>Controller level: Guards</li>
            <li>DTO level: Validation pipes</li>
            <li>Service level: Business logic checks</li>
            <li>Database level: Constraints</li>
            <li>Entity level: Hooks (@BeforeInsert)</li>
          </ul>
        </div>
      </div>
    </Card>
  </div>
</Layout>
